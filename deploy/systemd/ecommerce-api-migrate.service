[Unit]
Description=E-commerce bazasi migratsiyalarini qo‘llash
After=network.target

[Service]
Type=oneshot
User=ecommerce
Group=www-data
WorkingDirectory=/opt/ecommerce-api
EnvironmentFile=/etc/ecommerce-api.env
ExecStart=/opt/ecommerce-api/.venv/bin/alembic upgrade head
NoNewPrivileges=true
PrivateTmp=true
